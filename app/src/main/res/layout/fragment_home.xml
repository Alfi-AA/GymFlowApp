<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_background"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Alex!"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <!-- Container Target BW -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <!-- Icon Scale (Ukuran diatur manual disini, misal 16dp) -->
<!--                    <ImageView-->
<!--                        android:layout_width="16dp"-->
<!--                        android:layout_height="16dp"-->
<!--                        android:src="@drawable/ic_scale"-->
<!--                        app:tint="@color/gym_primary"-->
<!--                        android:layout_marginEnd="6dp"/>-->

                    <!-- Teks Target (Sudah Bahasa Inggris) -->
                    <TextView
                        android:id="@+id/tvTargetWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siap latihan hari ini!"
                        android:textColor="@color/gym_text_secondary"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Icon Notifikasi / Profile Kecil (Hiasan) -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_glass_panel"
                android:padding="8dp"
                app:tint="@color/gym_primary"/>
        </LinearLayout>

        <!-- 2. CARD RINGKASAN AKTIVITAS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/gym_surface"
            app:cardCornerRadius="20dp"
            android:layout_marginBottom="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <!-- Icon Bar Graph / Chart -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_graph"
                    app:tint="@color/gym_primary"
                    android:background="@drawable/bg_glass_panel"
                    android:padding="12dp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RINGKASAN AKTIVITAS"
                        android:textColor="@color/gym_text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Set Hari Ini: "
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvTotalSetCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/gym_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. CARD INPUT LATIHAN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/gym_surface"
            app:cardCornerRadius="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_pencil"
                        app:tint="@color/gym_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Catat Set Baru"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Chip Active -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_active"
                        android:backgroundTint="@color/gym_primary"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="AKTIF"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Input: Searchable Dropdown Latihan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PILIH ALAT / LATIHAN"
                    android:textColor="@color/gym_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/menuExercise"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="@color/gym_input_bg"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:boxStrokeColor="@color/gym_primary"
                    app:hintEnabled="false"
                    app:endIconTint="@color/gym_primary">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteExercise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Cari nama latihan..."
                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gym_text_secondary"
                        android:padding="16dp"
                        android:textSize="16sp"
                        android:background="@android:color/transparent" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Row: Beban & Reps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="24dp">

                    <!-- Kolom Beban -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEBAN"
                            android:textColor="@color/gym_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/gym_input_bg"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/etWeight"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="0"
                                    android:textColorHint="@color/gym_text_secondary"
                                    android:textColor="@color/white"
                                    android:inputType="number"
                                    android:paddingStart="16dp"
                                    android:paddingTop="16dp"
                                    android:paddingBottom="16dp"
                                    android:paddingEnd="48dp"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="KG"
                                    android:textColor="@color/gym_text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_gravity="end|center_vertical"
                                    android:layout_marginEnd="16dp"/>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Kolom Reps -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REPS"
                            android:textColor="@color/gym_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/gym_input_bg"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/etReps"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="0"
                                    android:textColorHint="@color/gym_text_secondary"
                                    android:textColor="@color/white"
                                    android:inputType="number"
                                    android:paddingStart="16dp"
                                    android:paddingTop="16dp"
                                    android:paddingBottom="16dp"
                                    android:paddingEnd="56dp"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="REPS"
                                    android:textColor="@color/gym_text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_gravity="end|center_vertical"
                                    android:layout_marginEnd="16dp"/>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Button Save -->
                <Button
                    android:id="@+id/btnSaveRecord"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Simpan Set"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:backgroundTint="@color/gym_primary"
                    app:cornerRadius="12dp"

                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/black"

                    android:elevation="12dp"
                    android:outlineProvider="background"
                    android:outlineSpotShadowColor="@color/white"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="80dp"
            android:baselineAligned="false">

            <!-- CARD OTOT TERLUPAKAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/gym_surface"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1AFFFFFF"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOKUS BERIKUTNYA"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#2A2A2A"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivNeglectedMuscleIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_icon_quad"
                            app:tint="#FF5252" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvNeglectedMuscleName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUADS"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jarang Dilatih"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        android:textStyle="italic"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD LATIHAN TERAKHIR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/gym_surface"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1AFFFFFF"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SET TERAKHIR"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:id="@+id/ivLastWorkoutRank"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/rank_gold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvLastWorkoutName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bench Press"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvLastWorkoutDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 kg x 10"
                        android:textColor="@color/gym_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>